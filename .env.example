# Copia este archivo con scripts/setup-local.sh. Nunca guardes secretos reales en Git.
LOCAL_POSTGRES_DB=walactv
LOCAL_POSTGRES_USER=walactv
LOCAL_POSTGRES_PASSWORD=CAMBIAR_GENERANDO_ENTORNO_LOCAL
DATABASE_URL=postgres://walactv:CAMBIAR_GENERANDO_ENTORNO_LOCAL@postgres:5432/walactv?sslmode=disable
APP_ORIGIN=http://127.0.0.1:8081
SESSION_SECRET=RELLENAR_CON_SECRETO_ALEATORIO
PROVIDER_IDENTITY_KEY=RELLENAR_CON_SECRETO_ALEATORIO
# Base64 de 32 bytes aleatorios. Conservar para recuperar las fuentes guardadas.
IPTV_ENCRYPTION_KEY=GENERAR_UNA_VEZ_CON_SCRIPTS_SETUP_LOCAL_SH
IPTV_ALLOWED_HOSTS=
# Opcional. Se usa solo en el proceso API; no configures nada si no tienes token.
TMDB_API_TOKEN=
VOD_TRANSCODING_ENABLED=false
API_REPLICAS=1
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_POR_CLAVE_SEGURA
